# Profiles: development (default), test, production. Unknown profiles fail startup.
# Production requires the three values below and rejects insecure overrides.
DJANGO_ENV=production
DEBUG=false

# Required: generate a fresh random secret with at least 50 characters.
# Never use a django-insecure- prefixed value or commit a real secret.
SECRET_KEY=
ALLOWED_HOSTS=api.example.edu
CORS_ALLOWED_ORIGINS=https://app.example.edu

# Set trusted HTTPS origins for browser requests using CSRF/session auth.
CSRF_TRUSTED_ORIGINS=https://app.example.edu
CORS_ALLOW_ALL_ORIGINS=false
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000

# Opt in only if you own EVERY subdomain and all of them support HTTPS.
# These options are deliberately opt-in; Django may recommend them in --deploy.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# The trusted reverse proxy must overwrite X-Forwarded-Proto with the client scheme.
# Secure proxy header: HTTP_X_FORWARDED_PROTO=https (configured in settings.py).
# Keep app servers reachable only through this proxy in production.

# Optional database URL. Empty uses backend/db.sqlite3.
# For persistent SQLite: sqlite:////data/db.sqlite3
# PostgreSQL example: postgresql://app_user:password@db:5432/university
DATABASE_URL=
# Optional upload directory; defaults beside a persistent SQLite database.
# MEDIA_ROOT=/data/media
